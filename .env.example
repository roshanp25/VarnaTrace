# Copy this file to .env (gitignored) and fill in what you need locally.

# Dev-only: makes the app act as if the subscription is active, so paid content isn't gated
# behind the paywall while you're testing. Only takes effect in a dev build (__DEV__) — inert in
# any production/release build regardless of this value. Leave unset for normal behavior.
# EXPO_PUBLIC_DEV_BYPASS_PAYWALL=true
